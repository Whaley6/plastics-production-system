# PostgreSQL Database Connection
# Option 1: Full Connection URL (works with local, Neon, Supabase, Railway, Render, ElephantSQL, etc.)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/plastics_db"

# Option 2: Individual Connection Parameters (uncomment if preferred)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=plastics_db
# PGSSL=false

# Optional Gemini API Key
GEMINI_API_KEY=""
